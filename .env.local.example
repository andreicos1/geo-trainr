# Google Maps Platform API key, exposed to the browser.
# Needs: Maps JavaScript API, Street View Static API.
# Restrict this key to your site's HTTP referrers in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: server-only Google Maps key used to fetch Street View Static
# images from the API route. A referrer-restricted key will reject
# server-side fetches (no browser referrer header), so this should be
# unrestricted or IP-restricted to your deployment. If unset, the server
# falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (only works if that key
# has no referrer restriction).
GOOGLE_MAPS_SERVER_API_KEY=

# OpenRouter API key, server-only, used by app/api/analyze-round/route.ts.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model used for round analysis.
# Defaults to google/gemini-2.5-pro if unset. Must be a vision-capable
# model that supports tool/function calling.
OPENROUTER_MODEL=

# Optional: sent as HTTP-Referer / X-Title headers to OpenRouter so usage
# is attributed to your app in their dashboard. Neither is required.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
